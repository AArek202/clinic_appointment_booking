# Loaded by the Nest API (ConfigModule) when the app runs on the host.
# Docker Compose does not read this file.
#
# localhost + published ports: compose exposes postgres on POSTGRES_PORT and
# redis on REDIS_PORT from the repo-root .env. Keep the credentials in these
# URLs in sync with POSTGRES_USER / POSTGRES_PASSWORD there.

# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic
# Separate database used by the integration/e2e suite
TEST_DATABASE_URL=postgres://clinic:clinic@localhost:5433/clinic_test

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379
# Redis database index used by the integration suite. Must not be 0 — the suite
# flushes it between tests, and database 0 holds real delayed reminder jobs.
TEST_REDIS_URL=redis://localhost:6379/1

# Auth — must be at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-min-32
JWT_EXPIRES_IN=1d

# Business configuration: the clinic's single timezone (IANA name).
# This changes what the API computes, not just how it runs.
CLINIC_TZ=Africa/Cairo

# Initial admin account, created by `npm run seed:admin`.
# Doctors are created by an admin, so this bootstraps the system.
ADMIN_EMAIL=admin@clinic.test
ADMIN_PASSWORD=change-me-admin-password
