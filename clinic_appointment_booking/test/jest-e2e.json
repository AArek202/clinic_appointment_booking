{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "@swc/jest",
      {
        "jsc": {
          "parser": {
            "syntax": "typescript",
            "decorators": true
          },
          "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true
          },
          "keepClassNames": true,
          "target": "es2022"
        },
        "module": {
          "type": "commonjs"
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(@nestjs/config|@nestjs/typeorm|es-toolkit|@standard-schema)/)"
  ],
  "globalSetup": "<rootDir>/test/setup-db.ts",
  "maxWorkers": 1
}
