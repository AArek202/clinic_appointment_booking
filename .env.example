# Docker Compose interpolation only (this file sits next to docker-compose.yml).
# The Nest API does not load these variables — see clinic_appointment_booking/.env.example.
#
# If you change user/password/ports here, update the DATABASE_URL / REDIS_URL
# values in the backend .env to match the published host ports.

POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic
POSTGRES_DB=clinic
POSTGRES_PORT=5432

TEST_POSTGRES_DB=clinic_test
TEST_POSTGRES_PORT=5433

REDIS_PORT=6379

# Passed into the api container (compose interpolation). Must stay in sync with
# clinic_appointment_booking/.env.example. JWT_SECRET must be at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-min-32
JWT_EXPIRES_IN=1d
CLINIC_TZ=Africa/Cairo
